{
  "name": "achegue-se",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "node --test",
    "predev": "node ./scripts/validate-public-env.mjs development --require-public-config && node ./scripts/copy-maplibre-worker.mjs",
    "prebuild": "node ./scripts/validate-public-env.mjs production && node ./scripts/copy-maplibre-worker.mjs",
    "env:check": "node ./scripts/validate-public-env.mjs development",
    "security:scan": "node ./scripts/ci/scan-repository-secrets.mjs",
    "release:preflight": "node ./scripts/release-preflight.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "maplibre-gl": "6.7.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
