# Canonical public URL used by sitemap/metadata in production.
NEXT_PUBLIC_SITE_URL=

# New Supabase project only. Do not point these at the legacy Achegue-se project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional map provider override. OpenFreeMap is the default.
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional comma-separated http(s) origins used by a custom map style
# for tiles, sprites or glyphs. Keep empty with the default provider.
NEXT_PUBLIC_MAP_CSP_ORIGINS=
